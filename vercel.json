{
  "version": 2,
  "name": "alberto-seguros",
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "api/cotacao.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/cotacao",
      "dest": "/api/cotacao.js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/dist/$1"
    }
  ]
}